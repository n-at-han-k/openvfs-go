require "context"
require "errors"
require "os"
require "os/signal"
require "path/filepath"
require "syscall"
require "time"

require "github.com/rs/zerolog"
require "github.com/rs/zerolog/log"
require "github.com/spf13/cobra"

module Main
  def main # ()
    log.Logger = log.Output(zerolog.ConsoleWriter.new(Out: os.Stderr, TimeFormat: time.RFC3339))

    rootCmd = @cobra.Command.new(
      Use: "openvfs <root> <mountpoint>",
      Short: "Mount a sync folder as a FUSE filesystem",
      Args: cobra.ExactArgs(2),
      RunE: lambda { |cmd, args| # (*cobra.Command, []string) -> error
        verbose, _ = cmd.Flags().GetBool("verbose")

        zerolog.SetGlobalLevel(zerolog.InfoLevel)
        if verbose
          zerolog.SetGlobalLevel(zerolog.DebugLevel)
        end

        root, err = filepath.Abs(args[0])
        if err
          return err
        end

        mountpoint, err = filepath.Abs(args[1])
        if err
          return err
        end

        dbPath, _ = cmd.Flags().GetString("db")
        if dbPath == ""
          return errors.New("--db is required: the journal cannot live under the synced root")
        end

        dbPath, err = filepath.Abs(dbPath)
        if err
          return err
        end

        owner, _ = cmd.Flags().GetString("owner")
        socketPath, _ = cmd.Flags().GetString("socket")
        remoteURL, _ = cmd.Flags().GetString("remote")
        remoteUser, _ = cmd.Flags().GetString("remote-user")
        remotePass, _ = cmd.Flags().GetString("remote-pass")
        remoteInsecure, _ = cmd.Flags().GetBool("remote-insecure")

        service = @Service.new(
          Root:       root,
          Mountpoint: mountpoint,
          DBPath:     dbPath,
          Owner:      owner,
          SocketPath: socketPath,

          RemoteURL:      remoteURL,
          RemoteUser:     remoteUser,
          RemotePass:     remotePass,
          RemoteInsecure: remoteInsecure,

          PollInterval:     30 * time.Second,
          HydrationTimeout: 300 * time.Second
        )

        ctx, cancel = signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
        defer cancel()

        return service.Run(ctx)
      }
    )

    if (err = rootCmd.Execute())
      log.Fatal().Err(err).Msg("openvfs")
    end
  end
end
