require "sync"
require "time"

module Vfs
  # HydJobState is the state a hydration job can be in.
  const :HydRunning, 0
  const :HydSuccess, 1
  const :HydFailed,  2

  # HydJobResult is the outcome after a job leaves Running.
  const :HydResultSucceeded, 0
  const :HydResultFailed,    1
  const :HydResultTimedOut,  2
  const :HydResultLost,      3

  class HydJob
    attr_accessor :State, int
  end

  # SharedMap coordinates hydration requests between FUSE open() and the socket
  # thread that talks to the desktop client.
  class SharedMap
    attr_accessor :mu,      sync.Mutex
    attr_accessor :data,    Hash[int, HydJob]
    attr_accessor :waiters, Array[Chan[bool]]
    attr_accessor :pid,     int64

    def notifyAllLocked # ()
      self.waiters.each do |_, ch|
        close(ch)
      end
      self.waiters = nil
    end

    def Insert(key, value) # (int, HydJob)
      self.mu.Lock()
      defer self.mu.Unlock()
      self.data[key] = value
      self.notifyAllLocked()
    end

    def Set(key, value) # (int, HydJob) -> bool
      self.mu.Lock()
      defer self.mu.Unlock()
      unless (_, found = self.data[key])
        return false
      end
      self.data[key] = value
      self.notifyAllLocked()
      return true
    end

    def Remove(key) # (int) -> bool
      self.mu.Lock()
      defer self.mu.Unlock()
      unless (_, found = self.data[key])
        return false
      end
      delete(self.data, key)
      self.notifyAllLocked()
      return true
    end

    def WaitForJob(key, timeout) # (int, time.Duration) -> int
      deadline = time.Now().Add(timeout)
      self.mu.Lock()
      defer self.mu.Unlock()

      loop do
        job, found = self.data[key]
        unless found
          return HydResultLost
        end

        if job.State != HydRunning
          if job.State == HydSuccess
            return HydResultSucceeded
          end
          return HydResultFailed
        end

        remaining = time.Until(deadline)
        if remaining <= 0
          return HydResultTimedOut
        end

        ch = make(Chan[bool])
        self.waiters = append(self.waiters, ch)
        self.mu.Unlock()

        timer = time.NewTimer(remaining)
        case
        when ch.<<
        when timer.C.<<
        end
        timer.Stop()

        self.mu.Lock()
      end
    end

    def SetDesktopClientPID(pid) # (int64)
      self.mu.Lock()
      defer self.mu.Unlock()
      self.pid = pid
    end

    def DesktopClientPID # () -> int64
      self.mu.Lock()
      defer self.mu.Unlock()
      return self.pid
    end
  end

  def NewSharedMap # () -> *SharedMap
    return @SharedMap.new(data: make(Hash[int, HydJob]))
  end
end
