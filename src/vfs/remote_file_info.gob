require "os"
require "path/filepath"
require "strconv"

require "github.com/vmihailenco/msgpack/v5"

module Vfs
  class RemoteFileInfo
    attr_accessor :AbsolutePath, string
    attr_accessor :Etag,         string
    attr_accessor :FileID,       string
    attr_accessor :Size,         uint64
    attr_accessor :State,        int
    attr_accessor :PinState,     int
    attr_accessor :ok,           bool

    def IsOK # () -> bool
      return self.ok
    end

    # RealSize is the on-disk size. When the fuse layer provides
    # user.openvfs.realsize that value wins; otherwise fall back to stat.
    def RealSize # () -> uint64
      data, err = LocalPath(self.AbsolutePath).GetXAttr(XAttrRealSize)
      unless err
        n, perr = strconv.ParseInt(string(data), 10, 64)
        if perr == nil
          return uint64(n)
        end
      end

      st, err = os.Stat(self.AbsolutePath)
      if err
        return 0
      end

      return uint64(st.Size())
    end
  end

  # RemoteFileInfoFromAttributes reads user.openvfs.data. ok is false when absent.
  def RemoteFileInfoFromAttributes(path) # (string) -> (RemoteFileInfo, bool)
    data, err = LocalPath(path).GetXAttr(XAttrData)
    if err
      return RemoteFileInfo.new(), false
    end

    var :m, Hash[string, any]
    if (err = msgpack.Unmarshal(data, @m))
      return RemoteFileInfo.new(), false
    end

    etag, _   = m["etag"].(string)
    fileID, _ = m["fileid"].(string)
    size, _   = m["size"].(uint64)
    state, _  = m["state"].(uint64)
    pin, _    = m["pinstate"].(uint64)

    return RemoteFileInfo.new(
      AbsolutePath: path,
      Etag:         etag,
      FileID:       fileID,
      Size:         size,
      State:        int(state),
      PinState:     int(pin),
      ok:           true
    ), true
  end

  # DefaultPlaceHolderData is returned for files with no user.openvfs.data.
  def DefaultPlaceHolderData # () -> []byte
    b, _ = msgpack.Marshal(Hash[string, any].new(
      "etag" => "",
      "fileid" => "",
      "size" => uint64(0),
      "state" => uint64(StateHydrated),
      "pinstate" => uint64(PinInherited)
    ))

    return b
  end

  # PlaceholderData marshals OpenVFS xattr data for a remote file.
  def PlaceholderData(etag, fileID, size, state, pinState) # (string, string, int64, int, int) -> []byte
    b, _ = msgpack.Marshal(Hash[string, any].new(
      "etag" => etag,
      "fileid" => fileID,
      "size" => uint64(size),
      "state" => uint64(state),
      "pinstate" => uint64(pinState)
    ))

    return b
  end

  # WriteDehydratedPlaceholder creates or updates a 0-byte placeholder file with
  # OpenVFS metadata. It does not overwrite hydrated file content.
  def WriteDehydratedPlaceholder(path, etag, fileID, size) # (string, string, string, int64) -> error
    if (err = os.MkdirAll(filepath.Dir(path), 0755))
      return err
    end

    st, err = os.Stat(path)
    if err == nil
      if st.IsDir()
        return nil
      end

      attr, ok = RemoteFileInfoFromAttributes(path)
      if ok && attr.IsOK()
        if attr.State == StateHydrated && st.Size() > 0
          return nil
        end

        if attr.State == StateDeHydrated && st.Size() == 0 && attr.Etag == etag && attr.FileID == fileID && attr.Size == uint64(size)
          return nil
        end
      end

      if (err = os.Truncate(path, 0))
        return err
      end
    else
      if !os.IsNotExist(err)
        return err
      end

      f, err = os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
      if err
        return err
      end

      f.Close()
    end

    data = PlaceholderData(etag, fileID, size, StateDeHydrated, PinInherited)
    return LocalPath(path).SetXAttr(XAttrData, data, 0)
  end
end
