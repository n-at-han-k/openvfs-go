require "os"
require "path/filepath"

require "example.com/project/src/journal"

module Directory
  class LocalInfo
    attr_accessor :path, string
    attr_accessor :name, string
    attr_accessor :typ, journal.ItemType
    attr_accessor :modtime, int64
    attr_accessor :size, int64
    attr_accessor :inode, uint64
    attr_accessor :isHidden, bool

    def IsHidden # () -> bool
      return self.isHidden
    end

    def Name # () -> string
      return self.name
    end

    def Path # () -> string
      return self.path
    end

    def ModTime # () -> int64
      return self.modtime
    end

    def Size # () -> int64
      return self.size
    end

    def Inode # () -> uint64
      return self.inode
    end

    def Type # () -> journal.ItemType
      return self.typ
    end

    def self.SetType(typ) # (journal.ItemType)
      self.typ = typ
    end

    def IsDirectory # () -> bool
      return self.typ == journal.ItemTypeDirectory
    end

    def IsVirtualFile # () -> bool
      return self.typ == journal.ItemTypeVirtualFile || self.typ == journal.ItemTypeVirtualFileDownload
    end

    def IsSymLink # () -> bool
      return self.typ == journal.ItemTypeSymLink
    end

    def IsValid # () -> bool
      return self.name != ""
    end
  end

  def NewLocalInfo(path) # (string) -> LocalInfo
    out = LocalInfo.new(path: path, name: filepath.Base(path), typ: journal.ItemTypeUnsupported)

    st, err = statLocalInfo(path)
    if err
      out.name = ""
      return out
    end

    out.inode = st.inode
    out.size = st.size
    out.modtime = st.modtime
    out.typ = st.typ
    out.isHidden = st.isHidden

    return out
  end

  def NewLocalInfoFromDirEntry(dir, entry) # (string, os.DirEntry) -> LocalInfo
    return NewLocalInfo(filepath.Join(dir, entry.Name()))
  end
end
