require "log"
require "os"
require "path/filepath"
require "sort"
require "strings"

require "example.com/project/src/journal"

module Directory
  class Scanner
    attr_accessor :root, string
    # func(string) bool
    attr_accessor :ignored, Proc
    attr_accessor :journal, @@journal.Journal

    attr_accessor :queryLocal, QueryMode
    attr_accessor :queryServer, QueryMode

    attr_accessor :ignoreHiddenFiles, bool

    # func(path PathTuple, localEntry LocalInfo, serverEntry RemoteFileData,
    #   dbEntry journal.SyncJournalFileRecord, queryLocal, queryServer QueryMode)
    attr_accessor :processFile, Proc

    # func(dir string) ([]RemoteFileData, error)
    attr_accessor :remoteEntries, Proc

    def self.Scan(onChange) # func(Event) -> error
      return self.process(PathTuple.new(), onChange)
    end

    def self.process(current, onChange) # PathTuple, func(Event) -> error
      queryServer = self.queryServer

      if self.remoteEntries == nil
        queryServer = ParentNotChanged
      end

      entries = make(Hash[string, @@dirEntries])

      at = lambda { |name| # (string) -> *dirEntries
        if (e, ok = entries[name])
          return e
        end

        e = @dirEntries.new()
        entries[name] = e

        return e
      }

      if queryServer == NormalQuery
        list, err = self.remoteEntries(current.Server)
        if err
          return err
        end

        list.each do |_, e|
          at(e.Name()).serverEntry = e
        end
      end

      recs, err = self.journal.ListFilesInPath(current.Original)
      if err
        return err
      end

      recs.each do |_, rec|
        at(rec.Name()).dbEntry = rec
      end

      if self.queryLocal == NormalQuery
        dir = filepath.Join(self.root, filepath.FromSlash(current.Local))
        dirents, err = os.ReadDir(dir)
        if err
          return err
        end

        dirents.each do |_, dirent|
          info = NewLocalInfoFromDirEntry(dir, dirent)

          if info.Type() == journal.ItemTypeUnsupported || !info.IsValid()
            next
          end

          at(info.Name()).localEntry = info
        end
      end

      names = make(Array[string], 0, len(entries))

      entries.each do |name|
        names = append(names, name)
      end

      sort.Strings(names)

      var :subdirs, Array[PathTuple]

      names.each do |_, name|
        e = entries[name]
        path = current.AddName(name)

        isHidden = e.localEntry.IsHidden() || strings.HasPrefix(name, ".")

        isDirectory = e.localEntry.IsDirectory() || e.serverEntry.IsDirectory()

        if self.handleExcluded(path.Target, isHidden)
          if !e.localEntry.IsValid() && e.dbEntry.IsValid()
            log.Printf("discovery: removing db entry for non existing ignored file: %s", path.Original)

            if (err = self.journal.DeleteRecord(path.Original))
              return err
            end
          end

          next
        end

        # TODO: _queryServer == InBlackList and the selective sync blacklist
        # divert to processBlacklisted() upstream.

        if onChange != nil && e.localEntry.IsValid() && !e.localEntry.IsDirectory()
          onChange(Event.new(Kind: LocalEntry, Path: path.Target, Local: e.localEntry))
        end

        if self.processFile != nil
          self.processFile(path, e.localEntry, e.serverEntry, e.dbEntry, self.queryLocal, queryServer)
        end

        if isDirectory
          subdirs = append(subdirs, path)
        end
      end

      subdirs.each do |_, sub|
        if (err = self.process(sub, onChange))
          return err
        end
      end

      return nil
    end

    def self.handleExcluded(path, isHidden) # (string, bool) -> bool
      if isHidden && self.ignoreHiddenFiles
        return true
      end

      return self.ignored != nil && self.ignored(path)
    end
  end

  def NewScanner(root, ignored, db) # string, func(string) bool, *journal.Journal -> *Scanner
    return @Scanner.new(root: root, ignored: ignored, journal: db)
  end

  var dirEntries = Struct.new(
    dbEntry: journal.SyncJournalFileRecord,
    serverEntry: RemoteFileData,
    localEntry: LocalInfo
  )

  class Diff
    attr_accessor :Added, Array[Event]
    attr_accessor :Modified, Array[Event]
    attr_accessor :Removed, Array[Event]

    def Events # () -> []Event
      all = make(Array[Event], 0, len(self.Added) + len(self.Modified) + len(self.Removed))
      all = append(all, *self.Added)
      all = append(all, *self.Modified)
      all = append(all, *self.Removed)

      sort.Slice(all, lambda { |i, j| # (int, int) -> bool
        return all[i].Path < all[j].Path
      })

      return all
    end
  end

  def calculateDiff(prev, fresh) # (map[string]journal.SyncJournalFileRecord, map[string]LocalInfo) -> Diff
    var :diff, Diff

    fresh.each do |path, info|
      old, ok = prev[path]

      if !ok
        diff.Added = append(diff.Added, Event.new(Kind: Create, Path: path))
      elsif old.FileSize != info.Size() || old.ModTime != info.ModTime() ||
        old.Type != info.Type() || old.Inode != info.Inode()
        diff.Modified = append(diff.Modified, Event.new(Kind: Write, Path: path))
      end
    end

    prev.each do |path|
      unless (_, ok = fresh[path])
        diff.Removed = append(diff.Removed, Event.new(Kind: Remove, Path: path))
      end
    end

    return diff
  end
end
