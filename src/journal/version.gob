require "database/sql"

module Journal
  CREATE_VERSION_TABLE = `CREATE TABLE IF NOT EXISTS version(
major INTEGER(8),
minor INTEGER(8),
patch INTEGER(8),
custom VARCHAR(256)
);`

  SET_VERSION_QUERY = `INSERT INTO version VALUES (?1, ?2, ?3, ?4);`

  GET_VERSION_QUERY = `SELECT major, minor, patch, custom FROM version;`

  var Version = Struct.new(
    Major: int,
    Minor: int,
    Patch: int,
    Custom: string
  )
end
