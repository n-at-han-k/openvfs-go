require "fmt"
require "strings"

module Journal
  CREATE_CHECKSUM_TYPE_TABLE = `CREATE TABLE IF NOT EXISTS checksumtype(
id INTEGER PRIMARY KEY,
name TEXT UNIQUE
);`

  class ChecksumAlgorithm < int
    def String # () -> string
      case self
      when ChecksumSHA3_256
        return "SHA3-256"
      when ChecksumSHA256
        return "SHA256"
      when ChecksumSHA1
        return "SHA1"
      when ChecksumMD5
        return "MD5"
      when ChecksumADLER32
        return "ADLER32"
      when ChecksumDummyForTests
        return "DUMMY_FOR_TESTS"
      end

      return "ERROR"
    end
  end

  const :ChecksumNone, 0
  const :ChecksumSHA3_256, 12
  const :ChecksumSHA256, 4
  const :ChecksumSHA1, 2
  const :ChecksumMD5, 1
  const :ChecksumADLER32, 100
  const :ChecksumDummyForTests, 101
  const :ChecksumParseError, 102

  var checksumAlgorithmsAll = Array[ChecksumAlgorithm].new(
    ChecksumSHA3_256,
    ChecksumSHA256,
    ChecksumSHA1,
    ChecksumMD5,
    ChecksumADLER32,
    ChecksumDummyForTests
  )

  def ChecksumAlgorithmFromName(s) # (string) -> ChecksumAlgorithm
    checksumAlgorithmsAll.each do |_, a|
      if a.String() == s
        return a
      end
    end

    return ChecksumParseError
  end

  def ChecksumAlgorithmFromString(s) # (string) -> ChecksumAlgorithm
    return ChecksumAlgorithmFromName(strings.ToUpper(s))
  end

  def FindBestChecksum(checksums) # (string) -> string
    if checksums == ""
      return ""
    end

    upper = strings.ToUpper(checksums)
    i = -1

    checksumAlgorithmsAll.each do |_, algo|
      at = strings.Index(upper, algo.String())

      if at != -1
        i = at
        break
      end
    end

    if i == -1
      return ""
    end

    end_ = strings.IndexByte(checksums[i...], ' ')

    if end_ == -1
      end_ = strings.IndexByte(checksums[i...], '<')
    end

    if end_ == -1
      return checksums[i...]
    end

    return checksums[i...i + end_]
  end

  class ChecksumHeader
    attr_accessor :checksumType, ChecksumAlgorithm
    attr_accessor :checksum, string
    attr_accessor :err, string

    def MakeChecksumHeader # () -> string
      unless self.IsValid()
        return ""
      end

      return self.checksumType.String() + ":" + self.checksum
    end

    def Type # () -> ChecksumAlgorithm
      return self.checksumType
    end

    def Checksum # () -> string
      return self.checksum
    end

    def Error # () -> string
      return self.err
    end

    def IsValid # () -> bool
      return self.checksumType != ChecksumNone && self.checksumType != ChecksumParseError && self.checksum != ""
    end
  end

  def ParseChecksumHeader(header) # (string) -> ChecksumHeader
    if header == ""
      return ChecksumHeader.new()
    end

    var :out, ChecksumHeader
    idx = strings.IndexByte(header, ':')

    if idx < 0
      out.err = fmt.Sprintf("The checksum header is malformed: %s", header)
    else
      out.checksumType = ChecksumAlgorithmFromString(header[...idx])

      if out.checksumType == ChecksumParseError
        out.err = fmt.Sprintf("The checksum header contained an unknown checksum type %q", header[...idx])
      end

      out.checksum = header[idx + 1...]
    end

    return out
  end

  def NewChecksumHeader(checksumType, checksum) # (ChecksumAlgorithm, string) -> ChecksumHeader
    return ChecksumHeader.new(checksumType: checksumType, checksum: checksum)
  end
end
