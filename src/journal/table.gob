  class Table
    attr_accessor :db, @@sql.DB
    attr_accessor :name, string
    attr_accessor :createSQL, string

    # Create creates the table using createSQL if it is set.
    def Create # () -> error
      if self.createSQL == ""
        return nil
      end

      _, err = self.db.Exec(self.createSQL)
      return err
    end

    # Insert executes an insert query and returns the last insert id.
    def Insert(query, args) # (string, ...any) -> (int64, error)
      res, err = self.db.Exec(query, *args)
      if err
        return 0, err
      end

      return res.LastInsertId()
    end

    # Exec executes a query that does not return rows.
    def Exec(query, args) # (string, ...any) -> (sql.Result, error)
      return self.db.Exec(query, *args)
    end

    # Query executes a query that returns rows.
    def Query(query, args) # (string, ...any) -> (*sql.Rows, error)
      return self.db.Query(query, *args)
    end

    # QueryRow executes a query that returns at most one row.
    def QueryRow(query, args) # (string, ...any) -> *sql.Row
      return self.db.QueryRow(query, *args)
    end
  end
end
