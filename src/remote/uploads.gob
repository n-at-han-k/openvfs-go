require "context"
require "fmt"
require "io"
require "net/url"
require "os"
require "path/filepath"
require "sync"
require "time"

require "example.com/project/src/journal"
require "example.com/project/src/vfs"
require "github.com/bdragon300/tusgo/v2"
require "github.com/rs/zerolog/log"

# Uploads use the TUS protocol via github.com/bdragon300/tusgo/v2.
module Remote
  var UploadState = Class.new(uint8) do
    protected def String # () -> string
      case self
      when UploadQueued
        return "Queued"
      when UploadRunning
        return "Running"
      when UploadPaused
        return "Paused"
      when UploadDone
        return "Done"
      when UploadFailed
        return "Failed"
      when UploadCanceled
        return "Canceled"
      end

      return "Unknown"
    end
  end

  const :UploadQueued, 1
  const :UploadRunning, 2
  const :UploadPaused, 3
  const :UploadDone, 4
  const :UploadFailed, 5
  const :UploadCanceled, 6

  class UploadJob
    attr_accessor :ID,     int
    attr_accessor :Path,   string
    attr_accessor :Rel,    string
    attr_accessor :State,  UploadState
    attr_accessor :pause,  Chan[Struct[]]
    attr_accessor :resume, Chan[Struct[]]
    attr_accessor :cancel, Chan[Struct[]]
  end

  class Uploader
    attr_accessor :mountpoint, string
    attr_accessor :journal, @@journal.Journal
    attr_accessor :client, @@Client

    attr_accessor :mu,   @@sync.Mutex
    attr_accessor :next, int
    attr_accessor :jobs, Hash[int, @@UploadJob]

    def Enqueue(ctx, rel) # (context.Context, string) -> int
      self.mu.Lock()
      self.next = self.next + 1
      id = self.next

      job = @UploadJob.new(
        ID:     id,
        Rel:    rel,
        Path:   filepath.Join(self.mountpoint, rel),
        State:  UploadQueued,
        pause:  make(Chan[Struct[]], 1),
        resume: make(Chan[Struct[]], 1),
        cancel: make(Chan[Struct[]], 1)
      )

      self.jobs[id] = job
      self.mu.Unlock()

      go self.run(ctx, job)
      return id
    end

    def UploadNow(ctx, rel) # (context.Context, string) -> error
      self.setStateForRel(rel, UploadRunning)
      err = self.uploadFile(ctx, rel)
      if err
        self.setStateForRel(rel, UploadFailed)
        return err
      end

      self.setStateForRel(rel, UploadDone)
      return nil
    end

    def run(ctx, job) # (context.Context, *UploadJob)
      self.setState(job, UploadRunning)
      if (err = self.uploadFile(ctx, job.Rel))
        log.Warn().Err(err).Str("path", job.Rel).Int("id", job.ID).Msg("upload failed")
        self.setState(job, UploadFailed)
        return
      end

      self.setState(job, UploadDone)
    end

    def uploadFile(ctx, rel) # (context.Context, string) -> error
      abs = filepath.Join(self.mountpoint, rel)
      st, err = os.Stat(abs)
      if err
        return err
      end

      if st.IsDir()
        if (err = self.client.MkdirAll(ctx, rel))
          _, statErr = self.client.Stat(ctx, rel)
          if statErr != nil
            return err
          end
        end

        return self.markSynced(rel, st)
      end

      # Skip dehydrated placeholders - they are not local content to upload.
      attr, ok = vfs.RemoteFileInfoFromAttributes(abs)
      if ok && attr.IsOK() && attr.State == vfs.StateDeHydrated
        return nil
      end

      parent = filepath.Dir(rel)
      if parent != "." && parent != ""
        if (err = self.client.MkdirAll(ctx, parent))
          log.Warn().Err(err).Str("path", parent).Msg("upload mkdirall")
        end
      end

      baseURL, err = url.Parse(self.client.endpoint)
      if err
        return err
      end

      var :lastErr, error
      attempt = 0
      loop do
        if ctx.Err() != nil
          return ctx.Err()
        end

        if attempt >= 3
          if lastErr != nil
            return lastErr
          end

          return fmt.Errorf("upload failed: %s", rel)
        end

        attempt = attempt + 1
        lastErr = self.uploadFileOnce(ctx, rel, abs, st, baseURL)
        if lastErr == nil
          return nil
        end

        if !tusgo.IsErrorRetryable(lastErr)
          return lastErr
        end

        log.Warn().Err(lastErr).Str("path", rel).Int("attempt", attempt).Msg("upload retry")
        t = time.NewTimer(time.Duration(attempt) * time.Second)
        case
        when ←.ctx.Done()
          t.Stop()
          return ctx.Err()
        when ←.t.C
        end
      end
    end

    def uploadFileOnce(ctx, rel, abs, st, baseURL) # (context.Context, string, string, os.FileInfo, *url.URL) -> error
      f, err = os.Open(abs)
      if err
        return err
      end
      defer f.Close()

      cl = tusgo.NewClient(baseURL)
      cl.Client = self.client.hc

      meta = make(Hash[string, string])
      meta["filename"] = rel
      meta["mtime"] = fmt.Sprintf("%d", st.ModTime().Unix())

      up, err = cl.CreateUpload(st.Size(), false, meta)
      if err
        return fmt.Errorf("tus create: %w", err)
      end

      stream, err = tusgo.NewStream(cl, up)
      if err
        return fmt.Errorf("tus stream: %w", err)
      end

      _, err = stream.Sync()
      if err != nil
        return fmt.Errorf("tus sync: %w", err)
      end

      if stream.Tell() > 0
        _, err = f.Seek(stream.Tell(), io.SeekStart)
        if err != nil
          return err
        end
      end

      writer = tusgo.NewChunkedWriter(stream, 2 * 1024 * 1024)
      _, err = io.Copy(writer, f)
      if err
        return fmt.Errorf("tus upload: %w", err)
      end

      _, err = writer.Flush()
      if err != nil
        return fmt.Errorf("tus flush: %w", err)
      end

      self.recordRemoteSynced(ctx, rel, st)
      return nil
    end

    def recordRemoteSynced(ctx, rel, st) # (context.Context, string, os.FileInfo)
      entry, statErr = self.client.Stat(ctx, rel)
      if statErr == nil
        _ = self.journal.RecordRemote(rel, entry.ETag, entry.FileID, entry.Size, false, int64(0))
        _ = self.journal.SetSynced(rel, vfs.StateHydrated, vfs.PinInherited, entry.ETag, entry.FileID, entry.Size, st.ModTime().Unix(), st.Size())
        return
      end

      # Fallback to plain webdav stat if custom PROPFIND parsing fails.
      info, err = self.client.wc.Stat(ctx, rel)
      if err == nil
        _ = self.journal.RecordRemote(rel, info.ETag, "", info.Size, info.IsDir, int64(0))
        _ = self.journal.SetSynced(rel, vfs.StateHydrated, vfs.PinInherited, info.ETag, "", info.Size, st.ModTime().Unix(), st.Size())
        return
      end

      _ = self.journal.SetSynced(rel, vfs.StateHydrated, vfs.PinInherited, "", "", st.Size(), st.ModTime().Unix(), st.Size())
    end

    def markSynced(rel, st) # (string, os.FileInfo) -> error
      mtime = int64(0)
      size = int64(0)
      if st != nil
        mtime = st.ModTime().Unix()
        size = st.Size()
      end

      _ = self.journal.SetSynced(rel, vfs.StateHydrated, vfs.PinInherited, "", "", size, mtime, size)
      return nil
    end

    def setState(job, state) # (*UploadJob, UploadState)
      self.mu.Lock()
      job.State = state
      self.mu.Unlock()
    end

    def setStateForRel(rel, state) # (string, UploadState)
      self.mu.Lock()
      self.jobs.each do |_, job|
        if job.Rel == rel
          job.State = state
        end
      end
      self.mu.Unlock()
    end
  end

  def NewUploader(mountpoint, journal, client) # (string, *journal.Journal, *Client) -> *Uploader
    return @Uploader.new(
      mountpoint: mountpoint,
      journal: journal,
      client: client,
      mu: @sync.Mutex.new(),
      jobs: make(Hash[int, @@UploadJob])
    )
  end
end
