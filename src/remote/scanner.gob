require "context"
require "path"
require "strings"

require "github.com/rs/zerolog/log"

module Remote
  # Scanner lists remote files over WebDAV.
  class Scanner
    attr_accessor :client, @@Client

    # Scan walks dir recursively and calls onEntry for each entry found.
    def Scan(ctx, dir, onEntry) # (context.Context, string, func(string, Entry)) -> error
      entries, err = self.client.List(ctx, dir)
      if err
        return err
      end

      entries.each do |_, entry|
        rel = strings.TrimLeft(entry.Path, "/")
        rel = path.Clean(rel)
        if rel == "." || rel == ""
          next
        end

        if onEntry != nil
          onEntry(rel, entry)
        end

        if entry.IsDir
          log.Debug().Str("path", rel).Msg("remote dir")
          if (err = self.Scan(ctx, rel, onEntry))
            log.Warn().Err(err).Str("path", rel).Msg("remote scan")
          end
        else
          log.Debug().Str("path", rel).Int64("size", entry.Size).Str("etag", entry.ETag).Msg("remote file")
        end
      end

      return nil
    end
  end

  def NewScanner(client) # (*Client) -> *Scanner
    return @Scanner.new(client: client)
  end
end
