require "context"
require "fmt"
require "os"
require "path/filepath"
require "sort"
require "strings"
require "time"

require "example.com/project/src/directory"
require "example.com/project/src/journal"
require "example.com/project/src/remote"
require "example.com/project/src/vfs"
require "github.com/rs/zerolog/log"

module Main
  var SyncRequest = Struct.new(Cause: directory.Event)

  var SyncOp = Class.new(uint8) do
    protected def String # () -> string
      case self
      when OpNone
        return "None"
      when OpDownloadPlaceholder
        return "DownloadPlaceholder"
      when OpDownloadContent
        return "DownloadContent"
      when OpUpload
        return "Upload"
      when OpMkdirRemote
        return "MkdirRemote"
      when OpMkdirLocal
        return "MkdirLocal"
      when OpDeleteRemote
        return "DeleteRemote"
      when OpDeleteLocal
        return "DeleteLocal"
      when OpMoveRemote
        return "MoveRemote"
      when OpMoveLocal
        return "MoveLocal"
      when OpConflict
        return "Conflict"
      when OpUpdateMetadata
        return "UpdateMetadata"
      end

      return "Unknown"
    end
  end

  const :OpNone, 0
  const :OpDownloadPlaceholder, 1
  const :OpDownloadContent, 2
  const :OpUpload, 3
  const :OpMkdirRemote, 4
  const :OpMkdirLocal, 5
  const :OpDeleteRemote, 6
  const :OpDeleteLocal, 7
  const :OpMoveRemote, 8
  const :OpMoveLocal, 9
  const :OpConflict, 10
  const :OpUpdateMetadata, 11

  var SyncAction = Struct.new(
    Op: SyncOp,
    Path: string,
    From: string,
    Entry: journal.Entry
  )

  class Syncer
    attr_accessor :mountpoint, string
    attr_accessor :scanner, @@directory.Scanner
    attr_accessor :remote, @@remote.Scanner
    attr_accessor :journal, @@journal.Journal
    attr_accessor :client, @@remote.Client
    attr_accessor :downloader, @@remote.Downloader
    attr_accessor :uploader, @@remote.Uploader
    attr_accessor :requests, Chan[SyncRequest]

    def Request(req) # (SyncRequest) -> bool
      case
      when self.requests.←.req
        return true
      else
        return false
      end
    end

    def Run(ctx) # (context.Context)
      loop do
        case
        when ←.ctx.Done()
          return
        when req = ←.self.requests
          self.sync(ctx, req)
        end
      end
    end

    def sync(ctx, req) # (context.Context, SyncRequest)
      log.Info().Str("cause", req.Cause.Kind.String()).Str("path", req.Cause.Path).Msg("sync")

      scanGen, err = self.journal.NextScanGen()
      if err
        log.Warn().Err(err).Msg("sync: scan gen")
        return
      end

      if (err = self.discoverLocal(ctx))
        log.Warn().Err(err).Msg("sync: discover local")
        return
      end

      if (err = self.discoverRemote(ctx, scanGen))
        log.Warn().Err(err).Msg("sync: discover remote")
        return
      end

      actions, err = self.reconcile(ctx, scanGen)
      if err
        log.Warn().Err(err).Msg("sync: reconcile")
        return
      end

      if (err = self.propagate(ctx, actions))
        log.Warn().Err(err).Msg("sync: propagate")
        return
      end

      log.Debug().Int("actions", len(actions)).Msg("sync: done")
    end

    def discoverLocal(ctx) # (context.Context) -> error
      return nil
    end

    def discoverRemote(ctx, scanGen) # (context.Context, int64) -> error
      if self.remote == nil
        return nil
      end

      return self.remote.Scan(ctx, "", lambda { |path, entry| # (string, remote.Entry)
        p = strings.TrimLeft(path, "/")
        p = filepath.ToSlash(p)
        if p == "." || p == ""
          return
        end

        _ = self.journal.RecordRemote(p, entry.ETag, entry.FileID, entry.Size, entry.IsDir, scanGen)
      })
    end

    def reconcile(ctx, scanGen) # (context.Context, int64) -> ([]SyncAction, error)
      entries, err = self.journal.Entries()
      if err
        return nil, err
      end

      actions = Array[SyncAction].new
      handled = make(Hash[string, bool])

      # Local move detection: same inode, old synced path missing locally, new path exists locally.
      localByInode = make(Hash[uint64, journal.Entry])
      entries.each do |_, e|
        if e.Inode != 0 && self.localExists(e.Path)
          localByInode[e.Inode] = e
        end
      end

      entries.each do |_, e|
        if e.Inode == 0 || self.localExists(e.Path)
          next
        end

        if e.LastSyncedEtag == "" && e.LastSyncedFileID == "" && e.RemoteEtag == "" && e.RemoteFileID == ""
          next
        end

        newE, ok = localByInode[e.Inode]
        unless ok
          next
        end

        if newE.Path == e.Path
          next
        end

        if (_, ok2 = handled[e.Path])
          next
        end
        if (_, ok3 = handled[newE.Path])
          next
        end

        # If new path already has remote identity, it's not a simple local move.
        if newE.RemoteEtag != "" || newE.RemoteFileID != "" || newE.LastSyncedEtag != "" || newE.LastSyncedFileID != ""
          next
        end

        handled[e.Path] = true
        handled[newE.Path] = true
        actions = append(actions, SyncAction.new(Op: OpMoveRemote, Path: newE.Path, From: e.Path, Entry: e))
      end

      # Remote move detection: same fileid disappeared at old path and appeared at new path.
      oldByFileID = make(Hash[string, journal.Entry])
      newByFileID = make(Hash[string, journal.Entry])
      entries.each do |_, e|
        if e.RemoteFileID != "" && e.RemoteSeen != scanGen && (e.LastSyncedFileID != "" || e.LastSyncedEtag != "" || e.RemoteEtag != "")
          oldByFileID[e.RemoteFileID] = e
        end
        if e.RemoteFileID != "" && e.RemoteSeen == scanGen
          newByFileID[e.RemoteFileID] = e
        end
      end

      oldByFileID.each do |fid, oldE|
        if (_, okOld = handled[oldE.Path])
          next
        end
        newE, ok = newByFileID[fid]
        unless ok
          next
        end

        if oldE.Path == newE.Path
          next
        end

        if (_, okNew = handled[newE.Path])
          next
        end

        handled[oldE.Path] = true
        handled[newE.Path] = true

        # Remote move: server wins.
        actions = append(actions, SyncAction.new(Op: OpMoveLocal, Path: newE.Path, From: oldE.Path, Entry: newE))
      end

      entries.each do |_, e|
        _, ok = handled[e.Path]
        if ok
          next
        end
        if e.Path == ""
          next
        end

        localExists = self.localExists(e.Path)
        remoteSeen = e.RemoteSeen == scanGen
        hadRemote = e.LastSyncedEtag != "" || e.LastSyncedFileID != "" || e.RemoteEtag != "" || e.RemoteFileID != ""
        localDirty = e.Dirty

        # Remote deleted (was known remotely, not seen in this scan): server wins.
        if hadRemote && !remoteSeen
          if localExists
            actions = append(actions, SyncAction.new(Op: OpDeleteLocal, Path: e.Path, Entry: e))
          else
            _ = self.journal.Forget(e.Path)
          end
          next
        end

        # Remote exists in this scan
        if remoteSeen
          if e.IsDir
            if !localExists
              actions = append(actions, SyncAction.new(Op: OpMkdirLocal, Path: e.Path, Entry: e))
            else
              _ = self.journal.SetSynced(e.Path, vfs.StateHydrated, vfs.PinInherited, e.RemoteEtag, e.RemoteFileID, e.RemoteSize, int64(0), int64(0))
            end
            next
          end

          remoteChanged = self.remoteChanged(e)

          if !localExists
            if hadRemote && !localDirty
              # Local deleted, remote still exists. If remote unchanged, propagate delete; if changed, restore remote.
              if remoteChanged
                actions = append(actions, SyncAction.new(Op: OpDownloadPlaceholder, Path: e.Path, Entry: e))
              else
                actions = append(actions, SyncAction.new(Op: OpDeleteRemote, Path: e.Path, Entry: e))
              end
            elsif hadRemote && localDirty
              # Local deleted but dirty? treat as conflict - restore remote.
              actions = append(actions, SyncAction.new(Op: OpDownloadPlaceholder, Path: e.Path, Entry: e))
            else
              actions = append(actions, SyncAction.new(Op: OpDownloadPlaceholder, Path: e.Path, Entry: e))
            end
            next
          end

          # Type change: server wins.
          localIsDir = self.localIsDir(e.Path)
          if localIsDir != e.IsDir
            actions = append(actions, SyncAction.new(Op: OpDeleteLocal, Path: e.Path, Entry: e))
            if e.IsDir
              actions = append(actions, SyncAction.new(Op: OpMkdirLocal, Path: e.Path, Entry: e))
            else
              actions = append(actions, SyncAction.new(Op: OpDownloadPlaceholder, Path: e.Path, Entry: e))
            end
            next
          end

          if remoteChanged
            # Remote changed: server wins.
            attr, ok = vfs.RemoteFileInfoFromAttributes(filepath.Join(self.mountpoint, e.Path))
            if ok && attr.IsOK() && attr.State == vfs.StateHydrated
              actions = append(actions, SyncAction.new(Op: OpDownloadContent, Path: e.Path, Entry: e))
            else
              actions = append(actions, SyncAction.new(Op: OpDownloadPlaceholder, Path: e.Path, Entry: e))
            end
            next
          end

          if localDirty
            actions = append(actions, SyncAction.new(Op: OpUpload, Path: e.Path, Entry: e))
          else
            # Keep synced metadata fresh.
            st, stErr = os.Stat(filepath.Join(self.mountpoint, e.Path))
            if stErr == nil
              _ = self.journal.SetSynced(e.Path, e.State, e.PinState, e.RemoteEtag, e.RemoteFileID, e.RemoteSize, st.ModTime().Unix(), st.Size())
            end
          end
          next
        end

        # Local only / not seen remotely
        if localExists
          if e.IsDir
            if !hadRemote
              actions = append(actions, SyncAction.new(Op: OpMkdirRemote, Path: e.Path, Entry: e))
            end
            next
          end

          if !hadRemote
            # Skip dehydrated placeholders with no remote identity? shouldn't happen.
            attr, ok = vfs.RemoteFileInfoFromAttributes(filepath.Join(self.mountpoint, e.Path))
            if ok && attr.IsOK() && attr.State == vfs.StateDeHydrated
              next
            end

            actions = append(actions, SyncAction.new(Op: OpUpload, Path: e.Path, Entry: e))
            next
          end

          if localDirty
            actions = append(actions, SyncAction.new(Op: OpConflict, Path: e.Path, Entry: e))
          end
        end
      end

      actions = self.sortActions(actions)
      return actions, nil
    end

    def propagate(ctx, actions) # (context.Context, []SyncAction) -> error
      actions.each do |_, a|
        if ctx.Err() != nil
          return ctx.Err()
        end

        log.Info().Str("op", a.Op.String()).Str("path", a.Path).Msg("sync action")

        var :err, error
        case a.Op
        when OpMkdirLocal
          err = self.doMkdirLocal(a)
        when OpDownloadPlaceholder
          err = self.doDownloadPlaceholder(a)
        when OpDownloadContent
          err = self.doDownloadContent(ctx, a)
        when OpDeleteLocal
          err = self.doDeleteLocal(a)
        when OpMkdirRemote
          err = self.doMkdirRemote(ctx, a)
        when OpUpload
          err = self.doUpload(ctx, a)
        when OpDeleteRemote
          err = self.doDeleteRemote(ctx, a)
        when OpMoveLocal
          err = self.doMoveLocal(a)
        when OpMoveRemote
          err = self.doMoveRemote(ctx, a)
        when OpConflict
          err = self.doConflict(a)
        when OpUpdateMetadata
          err = self.doUpdateMetadata(a)
        else
          err = nil
        end

        if err
          _ = self.journal.SetError(a.Path, err.Error())
          log.Warn().Err(err).Str("op", a.Op.String()).Str("path", a.Path).Msg("sync propagate")
        end
      end

      return nil
    end

    def doMkdirLocal(a) # (SyncAction) -> error
      p = filepath.Join(self.mountpoint, a.Path)
      if (err = os.MkdirAll(p, 0755))
        return err
      end

      st, err = os.Stat(p)
      if err == nil
        _ = self.journal.RecordDir(a.Path, directory.InodeOf(st), st.ModTime().Unix())
      end
      _ = self.journal.SetSynced(a.Path, vfs.StateHydrated, vfs.PinInherited, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize, int64(0), int64(0))
      return nil
    end

    def doDownloadPlaceholder(a) # (SyncAction) -> error
      p = filepath.Join(self.mountpoint, a.Path)
      if (err = vfs.WriteDehydratedPlaceholder(p, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize))
        return err
      end

      st, err = os.Stat(p)
      if err == nil
        _ = self.journal.Record(a.Path, directory.InodeOf(st), st.ModTime().Unix(), st.Size())
      end
      _ = self.journal.SetSynced(a.Path, vfs.StateDeHydrated, vfs.PinInherited, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize, int64(0), int64(0))
      return nil
    end

    def doDownloadContent(ctx, a) # (context.Context, SyncAction) -> error
      p = filepath.Join(self.mountpoint, a.Path)
      event = vfs.MountEvent.new(
        Kind: vfs.Hydrate,
        Path: p,
        FileID: a.Entry.RemoteFileID,
        Caller: nil,
        Reply: make(Chan[bool], 1)
      )

      # Direct download via downloader path: enqueue synthetic event.
      if self.downloader == nil
        return fmt.Errorf("no downloader")
      end

      self.downloader.Enqueue(ctx, event)
      case
      when ok = ←.event.Reply
        if !ok
          return fmt.Errorf("download failed")
        end
      when ←.ctx.Done()
        return ctx.Err()
      end

      st, err = os.Stat(p)
      if err == nil
        _ = self.journal.SetSynced(a.Path, vfs.StateHydrated, vfs.PinInherited, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize, st.ModTime().Unix(), st.Size())
      end
      return nil
    end

    def doDeleteLocal(a) # (SyncAction) -> error
      p = filepath.Join(self.mountpoint, a.Path)
      err = os.RemoveAll(p)
      if err != nil && !os.IsNotExist(err)
        return err
      end

      _ = self.journal.Forget(a.Path)
      return nil
    end

    def doMkdirRemote(ctx, a) # (context.Context, SyncAction) -> error
      if self.client == nil
        return fmt.Errorf("no remote client")
      end

      if (err = self.client.Mkdir(ctx, a.Path))
        # ignore already exists? webdav may error; try stat
        _, statErr = self.client.Stat(ctx, a.Path)
        if statErr != nil
          return err
        end
      end

      st, _ = os.Stat(filepath.Join(self.mountpoint, a.Path))
      mtime = int64(0)
      size = int64(0)
      if st != nil
        mtime = st.ModTime().Unix()
        size = st.Size()
      end

      entry, statErr = self.client.Stat(ctx, a.Path)
      if statErr == nil
        _ = self.journal.RecordRemote(a.Path, entry.ETag, entry.FileID, entry.Size, true, a.Entry.RemoteSeen)
        _ = self.journal.SetSynced(a.Path, vfs.StateHydrated, vfs.PinInherited, entry.ETag, entry.FileID, entry.Size, mtime, size)
      else
        _ = self.journal.SetSynced(a.Path, vfs.StateHydrated, vfs.PinInherited, "", "", int64(0), mtime, size)
      end
      return nil
    end

    def doUpload(ctx, a) # (context.Context, SyncAction) -> error
      if self.uploader == nil
        return fmt.Errorf("no uploader")
      end

      return self.uploader.UploadNow(ctx, a.Path)
    end

    def doDeleteRemote(ctx, a) # (context.Context, SyncAction) -> error
      if self.client == nil
        return fmt.Errorf("no remote client")
      end

      if (err = self.client.RemoveAll(ctx, a.Path))
        return err
      end

      _ = self.journal.Forget(a.Path)
      return nil
    end

    def doMoveLocal(a) # (SyncAction) -> error
      src = filepath.Join(self.mountpoint, a.From)
      dst = filepath.Join(self.mountpoint, a.Path)
      if (err = os.MkdirAll(filepath.Dir(dst), 0755))
        return err
      end

      _, statErr = os.Stat(src)
      if statErr == nil
        if (err = os.Rename(src, dst))
          return err
        end
      else
        # Source missing locally; recreate from remote.
        if a.Entry.IsDir
          if (err = os.MkdirAll(dst, 0755))
            return err
          end
        else
          if (err = vfs.WriteDehydratedPlaceholder(dst, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize))
            return err
          end
        end
      end

      _ = self.journal.Forget(a.From)
      st, err = os.Stat(dst)
      if err == nil
        if a.Entry.IsDir
          _ = self.journal.RecordDir(a.Path, directory.InodeOf(st), st.ModTime().Unix())
          _ = self.journal.SetSynced(a.Path, vfs.StateHydrated, vfs.PinInherited, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize, int64(0), int64(0))
        else
          _ = self.journal.Record(a.Path, directory.InodeOf(st), st.ModTime().Unix(), st.Size())
          state = vfs.StateDeHydrated
          attr, ok = vfs.RemoteFileInfoFromAttributes(dst)
          if ok && attr.IsOK() && attr.State == vfs.StateHydrated
            state = vfs.StateHydrated
          end
          _ = self.journal.SetSynced(a.Path, state, vfs.PinInherited, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize, st.ModTime().Unix(), st.Size())
        end
      end

      return nil
    end

    def doMoveRemote(ctx, a) # (context.Context, SyncAction) -> error
      if self.client == nil
        return fmt.Errorf("no remote client")
      end

      if (err = self.client.Move(ctx, a.From, a.Path, true))
        return err
      end

      entry, err = self.client.Stat(ctx, a.Path)
      if err == nil
        st, _ = os.Stat(filepath.Join(self.mountpoint, a.Path))
        mtime = int64(0)
        size = int64(0)
        if st != nil
          mtime = st.ModTime().Unix()
          size = st.Size()
        end

        _ = self.journal.Forget(a.From)
        _ = self.journal.RecordRemote(a.Path, entry.ETag, entry.FileID, entry.Size, entry.IsDir, a.Entry.RemoteSeen)
        if entry.IsDir
          _ = self.journal.SetSynced(a.Path, vfs.StateHydrated, vfs.PinInherited, entry.ETag, entry.FileID, entry.Size, mtime, size)
        else
          _ = self.journal.SetSynced(a.Path, a.Entry.State, a.Entry.PinState, entry.ETag, entry.FileID, entry.Size, mtime, size)
        end
      end

      return nil
    end

    def doConflict(a) # (SyncAction) -> error
      p = filepath.Join(self.mountpoint, a.Path)
      _, serr = os.Stat(p)
      if os.IsNotExist(serr)
        _ = self.journal.SetError(a.Path, "conflict: local missing")
        return nil
      end

      ext = filepath.Ext(a.Path)
      base = strings.TrimSuffix(a.Path, ext)
      conflict = fmt.Sprintf("%s (conflict %s)%s", base, time.Now().UTC().Format("20060102-150405"), ext)
      cp = filepath.Join(self.mountpoint, conflict)

      if (err = os.Rename(p, cp))
        return err
      end

      _ = self.journal.Forget(a.Path)
      st, err = os.Stat(cp)
      if err == nil
        _ = self.journal.Record(conflict, directory.InodeOf(st), st.ModTime().Unix(), st.Size())
        _ = self.journal.SetDirty(conflict)
      end

      # Recreate remote version as placeholder/content on next reconcile.
      return nil
    end

    def doUpdateMetadata(a) # (SyncAction) -> error
      _ = self.journal.SetSynced(a.Path, a.Entry.State, a.Entry.PinState, a.Entry.RemoteEtag, a.Entry.RemoteFileID, a.Entry.RemoteSize, a.Entry.LocalMTime, a.Entry.LocalSize)
      return nil
    end

    def localExists(rel) # (string) -> bool
      _, err = os.Stat(filepath.Join(self.mountpoint, rel))
      return err == nil
    end

    def localIsDir(rel) # (string) -> bool
      st, err = os.Stat(filepath.Join(self.mountpoint, rel))
      if err != nil
        return false
      end

      return st.IsDir()
    end

    def remoteChanged(e) # (journal.Entry) -> bool
      if e.LastSyncedEtag == "" && e.LastSyncedFileID == ""
        # never synced, but has remote; treat as remote authoritative if remote seen
        return false
      end

      if e.RemoteEtag != "" && e.LastSyncedEtag != "" && e.RemoteEtag != e.LastSyncedEtag
        return true
      end

      if e.RemoteFileID != "" && e.LastSyncedFileID != "" && e.RemoteFileID != e.LastSyncedFileID
        return true
      end

      if e.RemoteSize != e.LastSyncedSize && e.LastSyncedEtag != ""
        return true
      end

      return false
    end

    def isLocalDirty(rel, abs, e, info) # (string, string, journal.Entry, os.FileInfo) -> bool
      if e.LastSyncedEtag == "" && e.LastSyncedFileID == "" && e.RemoteEtag == "" && e.RemoteFileID == ""
        return true
      end

      # Dehydrated placeholders are not local dirty edits.
      attr, ok = vfs.RemoteFileInfoFromAttributes(abs)
      if ok && attr.IsOK() && attr.State == vfs.StateDeHydrated
        return false
      end

      if e.LastSyncedLocalMTime != 0 && info.ModTime().Unix() != e.LastSyncedLocalMTime
        return true
      end

      if e.LastSyncedLocalSize != 0 && info.Size() != e.LastSyncedLocalSize
        return true
      end

      if e.Dirty
        return true
      end

      # If we have no synced baseline, but it's a real hydrated file, be conservative.
      if e.LastSyncedLocalMTime == 0 && e.LastSyncedLocalSize == 0 && ok && attr.IsOK() && attr.State == vfs.StateHydrated
        return false
      end

      return false
    end

    def shouldIgnore(rel) # (string) -> bool
      base = filepath.Base(rel)
      if strings.HasPrefix(base, ".openvfs-download-") || strings.HasPrefix(base, ".openvfs-upload-")
        return true
      end

      if self.scanner != nil && self.scanner.Ignored(rel)
        return true
      end

      return false
    end

    def sortActions(actions) # ([]SyncAction) -> []SyncAction
      sort.Slice(actions, lambda { |i, j| # (int, int) -> bool
        ai = actions[i]
        aj = actions[j]
        if ai.Op != aj.Op
          return ai.Op < aj.Op
        end
        return ai.Path < aj.Path
      })

      return actions
    end
  end

  def NewSyncer(scanner, journal, remoteScanner, client, mountpoint, downloader, uploader) # (*directory.Scanner, *journal.Journal, *remote.Scanner, *remote.Client, string, *remote.Downloader, *remote.Uploader) -> *Syncer
    return @Syncer.new(
      mountpoint: mountpoint,
      scanner: scanner,
      remote: remoteScanner,
      journal: journal,
      client: client,
      downloader: downloader,
      uploader: uploader,
      requests: make(Chan[SyncRequest], 128)
    )
  end
end
