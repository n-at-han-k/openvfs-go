#go:build windows

require "example.com/project/packages/openvfs/windows"

module Openvfs
  # On Windows the filesystem is the cloud filter, in packages/openvfs/windows:
  # Windows itself is the provider, so there is nothing to mount and no socket
  # API to serve.

  var run = windows.Run
  var serveAPI = windows.ServeAPI
  var mainCmd = windows.Main
  var runStat = windows.RunStat
end
