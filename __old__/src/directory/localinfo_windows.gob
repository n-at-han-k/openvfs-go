#go:build windows

require "time"
require "unsafe"

require "golang.org/x/sys/windows"

require "example.com/project/src/journal"

module Directory
  var localStat = Struct.new(
    inode: uint64,
    size: int64,
    modtime: int64,
    typ: journal.ItemType,
    isHidden: bool
  )

  FILE_ATTRIBUTE_TAG_INFO_CLASS = 9

  var fileAttributeTagInfo = Struct.new(
    FileAttributes: uint32,
    ReparseTag: uint32
  )

  def isReparseTagNameSurrogate(tag) # (uint32) -> bool
    return tag & 0x20000000 != 0
  end

  def statLocalInfo(path) # (string) -> (localStat, error)
    p, err = windows.UTF16PtrFromString(path)
    if err
      return localStat.new(), err
    end

    h, err = windows.CreateFile(p, 0,
      windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE | windows.FILE_SHARE_DELETE,
      nil, windows.OPEN_EXISTING,
      windows.FILE_FLAG_BACKUP_SEMANTICS | windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
    if err
      return localStat.new(), err
    end

    defer windows.CloseHandle(h)

    var :info, windows.ByHandleFileInformation

    if (err = windows.GetFileInformationByHandle(h, @info))
      return localStat.new(), err
    end

    out = localStat.new(
      inode: uint64(info.FileIndexHigh) << 32 | uint64(info.FileIndexLow),
      size: int64(info.FileSizeHigh) << 32 | int64(info.FileSizeLow),
      modtime: time.Unix(0, info.LastWriteTime.Nanoseconds()).Unix(),
      isHidden: info.FileAttributes & windows.FILE_ATTRIBUTE_HIDDEN != 0
    )

    isSymLink = false

    if info.FileAttributes & windows.FILE_ATTRIBUTE_REPARSE_POINT != 0
      var :tagInfo, fileAttributeTagInfo

      # Go casts the raw pointer to (*byte); Gob has no spelling for a
      # conversion to a pointer type.
      raw = unsafe.Pointer(@tagInfo)

      if (err = windows.GetFileInformationByHandleEx(h, FILE_ATTRIBUTE_TAG_INFO_CLASS,
        raw, uint32(unsafe.Sizeof(tagInfo))))
        return localStat.new(), err
      end

      isSymLink = isReparseTagNameSurrogate(tagInfo.ReparseTag)
    end

    if isSymLink
      out.typ = journal.ItemTypeSymLink
    elsif info.FileAttributes & windows.FILE_ATTRIBUTE_DIRECTORY != 0
      out.typ = journal.ItemTypeDirectory
    else
      out.typ = journal.ItemTypeFile
    end

    return out, nil
  end
end
