# Package openvfs mounts the sync folder as a FUSE filesystem.
#
# The mount is a passthrough over root: the kernel sees every file that is
# already there, and go-fuse answers the filesystem calls from the directory
# below the mount.

require "github.com/hanwen/go-fuse/v2/fs"
require "github.com/hanwen/go-fuse/v2/fuse", gofuse

module Openvfs
  # Mount serves root at mountpoint and returns once the mount is live. The
  # caller waits on the server and unmounts it.
  def Mount(root, mountpoint) # (string, string) -> (*gofuse.Server, error)
    loopback, err = fs.NewLoopbackRoot(root)
    if err
      return nil, err
    end

    opts = @fs.Options.new(
      MountOptions: gofuse.MountOptions.new(
        Name: "openvfs",
        FsName: root
      )
    )

    return fs.Mount(mountpoint, loopback, opts)
  end
end
