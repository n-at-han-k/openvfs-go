#go:build linux || darwin

require "bytes"
require "fmt"
require "os"
require "strconv"

require "github.com/vmihailenco/msgpack/v5"

module Unix
  # toMsgpack is nlohmann::json::to_msgpack(), byte for byte. nlohmann backs a
  # JSON object with a std::map, so its keys go out in increasing order, and it
  # writes every integer in the narrowest form that holds it.
  def toMsgpack(v) # (any) -> ([]byte, error)
    var :buf, bytes.Buffer

    enc = msgpack.NewEncoder(@buf)
    enc.SetSortMapKeys(true)
    enc.UseCompactInts(true)

    if (err = enc.Encode(v))
      return nil, err
    end

    return buf.Bytes(), nil
  end

  # Transpiled from src/openvfs/{h,cpp}.

  # Registration is the blob stored in user.registration.
  class Registration
    attr_accessor :Path, string
    attr_accessor :Owner, string
    attr_accessor :Version, int
    attr_accessor :Error, string

    def IsOK # () -> bool
      return self.Error == ""
    end

    def ToData # () -> ([]byte, error)
      return toMsgpack(Hash[string, any].new(
        RegistrationOwner.String() => self.Owner,
        RegistrationVersion.String() => self.Version
      ))
    end
  end

  # registrationData is the anonymous msgpack struct of
  # RegistrationFromData; Gob needs a named type for it.
  var registrationData = Struct.new(
    # `msgpack:"owner"`
    Owner: string,
    # `msgpack:"version"`
    Version: int
  )

  def newRegistration(absolutePath, owner) # (string, string) -> Registration
    return Registration.new(Path: absolutePath, Owner: owner, Version: Version)
  end

  def RegistrationFromData(absolutePath, d) # (string, []byte) -> Registration
    if len(d) == 0
      out = newRegistration(absolutePath, "")
      out.Error = "Invalid path"

      return out
    end

    var :j, registrationData

    if (err = msgpack.Unmarshal(d, @j))
      # nlohmann throws here; upstream lets it propagate, we report it.
      out = newRegistration(absolutePath, "")
      out.Error = err.Error()

      return out
    end

    info = newRegistration(absolutePath, j.Owner)
    info.Version = j.Version

    return info
  end

  def RegistrationFromAttributes(absolutePath) # (string) -> Registration
    data, ok = xattrGetString(absolutePath, XAttrRegistration)

    unless ok
      out = newRegistration(absolutePath, "")
      out.Error = "No registration info found"

      return out
    end

    return RegistrationFromData(absolutePath, Array[byte].new(data))
  end

  def RegisterFilesystem(path, owner) # (string, string) -> Registration
    existing = RegistrationFromAttributes(path)

    if existing.IsOK() && existing.Owner != owner
      existing.Error = fmt.Sprintf("Failed to register OpenVFS. The path '%s' is owned by: %s", path, existing.Owner)

      return existing
    end

    info = newRegistration(path, owner)

    registration, err = info.ToData()
    if err
      info.Error = "Failed to register OpenVFS"

      return info
    end

    if xattrSet(path, XAttrRegistration, registration, 0) != nil
      info.Error = "Failed to register OpenVFS"

      return info
    end

    return info
  end

  def UnregisterFilesystem(info) # (Registration) -> bool
    if xattrRemove(info.Path, XAttrRegistration) != nil
      fmt.Fprintln(os.Stderr, "Failed to unregister OpenVFS")

      return false
    end

    # TODO: what to do with dehydtrated files
    return true
  end

  # PlaceHolderAttributes is the blob stored in user.data.
  class PlaceHolderAttributes
    attr_accessor :AbsolutePath, string
    attr_accessor :Etag, string
    attr_accessor :FileID, string
    attr_accessor :Size, uint64
    attr_accessor :State, State
    attr_accessor :PinState, PinState

    attr_accessor :ok, bool

    def IsOK # () -> bool
      return self.ok
    end

    def ToData # () -> ([]byte, error)
      # Upstream asserts isOk() here.
      return toMsgpack(Hash[string, any].new(
        AttrEtag.String() => self.Etag,
        AttrFileID.String() => self.FileID,
        AttrSize.String() => self.Size,
        AttrState.String() => uint8(self.State),
        AttrPinState.String() => uint8(self.PinState)
      ))
    end

    # RealSize is PlaceHolderAttributes::realSize().
    def RealSize # () -> uint64
      size, ok = xattrGetString(self.AbsolutePath, XAttrRealSize)

      unless ok
        # the fuse layer is not available, so we can use the actual file size
        st, err = os.Stat(self.AbsolutePath)
        if err
          return 0
        end

        return uint64(st.Size())
      end

      n, err = strconv.ParseInt(size, 10, 64)
      if err
        return 0
      end

      return uint64(n)
    end

    def Validate # () -> bool
      unless self.ok
        return false
      end

      case self.State
      when StateHydrated
        return self.Size == 0
      when StateDehydrated
        return self.RealSize() == 0
      when StateHydrating
        return true
      end

      return true
    end
  end

  # placeHolderData is the anonymous msgpack struct of PlaceHolderFromData;
  # Gob needs a named type for it.
  var placeHolderData = Struct.new(
    # `msgpack:"etag"`
    Etag: string,
    # `msgpack:"fileid"`
    FileID: string,
    # `msgpack:"size"`
    Size: uint64,
    # `msgpack:"state"`
    State: uint8,
    # `msgpack:"pinstate"`
    PinState: uint8
  )

  # NewPlaceHolderAttributes creates a PlaceHolderAttributes object from a given
  # absolute path. It is assumed the file exists and is not a placeholder.
  def NewPlaceHolderAttributes(absolutePath) # (string) -> PlaceHolderAttributes
    # Upstream's default member initialisers: an existing file is assumed.
    return PlaceHolderAttributes.new(
      AbsolutePath: absolutePath,
      State: StateHydrated,
      PinState: PinInherited
    )
  end

  # CreatePlaceHolder is PlaceHolderAttributes::create().
  def CreatePlaceHolder(absolutePath, etag, fileID, size) # (string, string, string, uint64) -> PlaceHolderAttributes
    return PlaceHolderAttributes.new(
      AbsolutePath: absolutePath,
      Etag: etag,
      FileID: fileID,
      Size: size,
      State: StateDehydrated,
      PinState: PinInherited,
      ok: true
    )
  end

  def PlaceHolderFromData(absolutePath, d) # (string, []byte) -> PlaceHolderAttributes
    if len(d) == 0
      return NewPlaceHolderAttributes(absolutePath)
    end

    var :j, placeHolderData

    if (err = msgpack.Unmarshal(d, @j))
      # nlohmann throws here; upstream lets it propagate.
      return NewPlaceHolderAttributes(absolutePath)
    end

    return PlaceHolderAttributes.new(
      AbsolutePath: absolutePath,
      Etag: j.Etag,
      FileID: j.FileID,
      Size: j.Size,
      State: State(j.State),
      PinState: PinState(j.PinState),
      ok: true
    )
  end

  # PlaceHolderFromAttributes is the std::optional-returning overload: ok is
  # false when the attribute is absent.
  def PlaceHolderFromAttributes(absolutePath) # (string) -> (PlaceHolderAttributes, bool)
    data, ok = xattrGetString(absolutePath, XAttrData)

    unless ok
      return PlaceHolderAttributes.new(), false
    end

    return PlaceHolderFromData(absolutePath, Array[byte].new(data)), true
  end

  # DefaultData is the lambda in openVFSfuse_getxattr(): the attributes handed
  # out for a file that carries no data attribute of its own.
  def DefaultData # () -> []byte
    attributes = CreatePlaceHolder("", "", "", 0)
    attributes.State = StateHydrated
    data, _ = attributes.ToData()

    return data
  end

  # SetPlaceHolderAttributes has no upstream counterpart; upstream writes the
  # data attribute only through the fuse setxattr entry point. It is kept so a
  # dehydrator can produce placeholders.
  def SetPlaceHolderAttributes(path, attr) # (string, PlaceHolderAttributes) -> error
    data, err = attr.ToData()
    if err
      return err
    end

    return xattrSet(path, XAttrData, data, 0)
  end
end
