#go:build windows

require "fmt"
require "os"
require "runtime"
require "sync"
require "unsafe"

require "github.com/deploymenttheory/go-bindings-win32/bindings/win32/storage/cloudfilters", cf

module Windows
  # Transpiled from src/plugins/vfs/cfapi/hydrationdevice.{h,cpp}.

  # ChunkSize is 4_KiB.
  const :ChunkSize, 4 * 1024
  # BufferSize is 4_MiB.
  const :BufferSize, 4 * 1024 * 1024

  # HydrationJob is the part of OCC::HydrationJob (libsync/vfs/hydrationjob.h)
  # the cfapi plugin drives. The download itself is a GETFileJob in libsync; here
  # it is the Fetch function the owner installs, which writes the body into the
  # device exactly as the QIODevice pipeline does.
  class HydrationJob
    attr_accessor :vfs, @@VfsCfApi
    attr_accessor :fileID, Array[byte]
    attr_accessor :device, @@HydrationDevice
    # Fetch streams the remote contents into the device. It stands in for
    # HydrationJob::start()'s GETFileJob.
    # func(fileID []byte, device *HydrationDevice) error
    attr_accessor :Fetch, Proc

    attr_accessor :fileName, string
    attr_accessor :record, SyncFileItem

    # OnFinished and OnError are the finished() and error() signals.
    # func()
    attr_accessor :OnFinished, Proc
    # func(err string)
    attr_accessor :OnError, Proc

    attr_accessor :aborted, Chan[bool]
    attr_accessor :once, sync.Once

    def self.Vfs # () -> *VfsCfApi
      return self.vfs
    end

    def self.FileID # () -> []byte
      return self.fileID
    end

    def self.Device # () -> *HydrationDevice
      return self.device
    end

    def self.Record # () -> SyncFileItem
      return self.record
    end

    # SetTargetFile is HydrationJob::setTargetFile().
    def self.SetTargetFile(fileName) # (string)
      self.fileName = fileName
    end

    def self.TargetFileName # () -> string
      return self.fileName
    end

    # Start is HydrationJob::start().
    def self.Start # ()
      go lambda {
        if self.Fetch == nil
          self.emitError("no hydration transport installed")
          return
        end

        if (err = self.Fetch(self.fileID, self.device))
          self.emitError(err.Error())
          return
        end

        self.emitFinished()
      }.()
    end

    # Abort is HydrationJob::abort().
    def self.Abort # ()
      self.once.Do(lambda {
        close(self.aborted)
        self.emitError("aborted")
      })
    end

    # Aborted reports whether Abort has been called, so a Fetch can stop early.
    def self.Aborted # () -> <-chan bool
      return self.aborted
    end

    def self.emitFinished # ()
      if self.OnFinished != nil
        self.OnFinished()
      end
    end

    def self.emitError(err) # (string)
      if self.OnError != nil
        self.OnError(err)
      end
    end
  end

  # CfApiHydrationJob is the class of the same name: a HydrationJob that also
  # remembers the callback context it was created for.
  #
  # Upstream embeds *HydrationJob; Gob has no spelling for an embedded field,
  # so it is a named one here.
  class CfApiHydrationJob
    attr_accessor :HydrationJob, @@HydrationJob
    attr_accessor :context, CallBackContext

    def self.SetContext(context) # (CallBackContext)
      self.context = context
    end

    def self.Context # () -> CallBackContext
      return self.context
    end
  end

  def NewHydrationJob(v, fileID, device) # (*VfsCfApi, []byte, *HydrationDevice) -> *HydrationJob
    return @HydrationJob.new(vfs: v, fileID: fileID, device: device, aborted: make(Chan[bool]))
  end

  # HydrationDevice is the QIODevice the downloaded bytes are written into. It
  # forwards them to the cloud filter in ChunkSize aligned blocks.
  class HydrationDevice
    attr_accessor :context, CallBackContext
    # totalSize is the expected total size.
    attr_accessor :totalSize, int64
    # offset is the current offset.
    attr_accessor :offset, int64

    attr_accessor :buffer, Array[byte]

    attr_accessor :errorString, string

    # ReadData is HydrationDevice::readData(), which upstream marks unreachable.
    def self.ReadData(p) # ([]byte) -> (int, error)
      return 0, fmt.Errorf("HydrationDevice is write only")
    end

    # Write is HydrationDevice::writeData(). It keeps the io.Writer contract so a
    # download can be streamed straight into it.
    def self.Write(data) # ([]byte) -> (int, error)
      n, err = self.writeData(data)
      if err
        return 0, err
      end

      return n, nil
    end

    def self.writeData(data) # ([]byte) -> (int, error)
      length = len(data)
      self.buffer = append(self.buffer, *data)
      isLastChunk = (self.offset + int64(len(self.buffer))) >= self.totalSize

      # only write if the buffer is decently filled, or we are in the last chunk
      if len(self.buffer) >= BufferSize * 9 / 10 || isLastChunk
        # ensure we chunk the writes to the block size, if we are at then end
        # of the file take all the rest
        var :currentBlockLength, int

        if isLastChunk
          # we are in the last chunk, use everything
          currentBlockLength = len(self.buffer)
        else
          # align the current block with ChunkSize
          currentBlockLength = len(self.buffer) - len(self.buffer) % ChunkSize
        end

        opInfo = cf.CF_OPERATION_INFO.new()
        opInfo.StructSize = uint32(unsafe.Sizeof(opInfo))
        opInfo.Type = cf.CF_OPERATION_TYPE_TRANSFER_DATA
        opInfo.ConnectionKey = self.context.ConnectionKey
        opInfo.TransferKey = self.context.TransferKey

        opParams = cf.CF_OPERATION_PARAMETERS.new()
        opParams.ParamSize = sizeOfOpParamTransferData
        transfer = transferDataArm(@opParams)
        transfer.CompletionStatus = STATUS_SUCCESS

        if currentBlockLength > 0
          transfer.Buffer = unsafe.Pointer(@self.buffer[0])
        end

        transfer.Offset = self.offset
        transfer.Length = int64(currentBlockLength)

        cfExecuteErr = cf.CfExecute(@opInfo, @opParams)

        # the buffer is handed to the API as a raw pointer
        runtime.KeepAlive(self.buffer)

        if cfExecuteErr
          lcCfApiHydrationDevice.Critical("Couldn't send transfer info %s : %v",
            self.context, cfExecuteErr)
          self.errorString = cfExecuteErr.Error()

          return 0, cfExecuteErr
        end

        trailing = len(self.buffer) - currentBlockLength

        if trailing > 0
          # move the memory to the front
          copy(self.buffer, self.buffer[currentBlockLength...])
        end

        # this won't reduce the allocated size
        self.buffer = self.buffer[...trailing]

        self.offset = self.offset + int64(currentBlockLength)

        # refresh Windows Copy Dialog progress
        progressTotal = self.totalSize
        progressCompleted = self.offset

        if (err = cf.CfReportProviderProgress(self.context.ConnectionKey, self.context.TransferKey,
          progressTotal, progressCompleted))
          lcCfApiHydrationDevice.Critical("Couldn't report provider progress %s : %v", self.context, err)
        end
      end

      return length, nil
    end

    # Close is HydrationDevice::close().
    def self.Close # () -> error
      if len(self.buffer) != 0
        # upstream asserts the buffer is empty here
        lcCfApiHydrationDevice.Warning("closing the hydration device with %d bytes still buffered", len(self.buffer))
      end

      return nil
    end

    # ErrorString is QIODevice::errorString().
    def self.ErrorString # () -> string
      return self.errorString
    end
  end

  def NewHydrationDevice(context, totalSize) # (CallBackContext, int64) -> *HydrationDevice
    return @HydrationDevice.new(
      context: context,
      totalSize: totalSize,
      # we reserve a fixed size and don't expect to ever grow the array
      buffer: make(Array[byte], 0, BufferSize)
    )
  end

  # RequestHydration is HydrationDevice::requestHydration().
  def RequestHydration(context, totalSize) # (CallBackContext, int64) -> *CfApiHydrationJob
    lcCfApiHydrationDevice.Info("Requesting hydration %s", context)

    v = context.Vfs

    if v == nil
      return nil
    end

    if (_, running = v.hydrationJobs[context.TransferKey])
      lcCfApiHydrationDevice.Warning("Ignoring hydration request for running hydration %s", context)
      return nil
    end

    # we assume that transferKey is unique and that we don't receive multiple
    # requests for the same file with the same key
    v.hydrationJobs.each do |_, it|
      if it.Context().Path == context.Path
        lcCfApiHydrationDevice.Warning("A hydration for %s is already running", context.Path)
        return nil
      end
    end

    device = NewHydrationDevice(context, totalSize)
    hydration = @CfApiHydrationJob.new(HydrationJob: NewHydrationJob(v, context.FileID, device))
    hydration.SetContext(context)
    v.hydrationJobs[context.TransferKey] = hydration

    hydration.OnFinished = lambda {
      v.post(lambda {
        delete(v.hydrationJobs, hydration.Context().TransferKey)

        _, err = os.Stat(hydration.Context().Path)

        if err == nil
          item = hydration.Record()

          # the file is now downloaded
          item.Type = ItemTypeFile

          if (inode, ok = getInode(hydration.Context().Path))
            item.Inode = inode
          else
            lcCfApiHydrationDevice.Warning("Failed to get inode for %s", hydration.Context().Path)
          end

          if v.params.Journal == nil
            return
          end

          if (err = v.params.Journal.SetFileRecord(item))
            lcCfApiHydrationDevice.Warning("Error when setting the file record to the database %s %v",
              hydration.Context(), err)
          else
            lcCfApiHydrationDevice.Info("Hydration succeeded %s", hydration.Context())
          end
        else
          lcCfApiHydrationDevice.Warning("Hydration succeeded but the file appears to be moved %s", hydration.Context())
        end
      })
    }

    hydration.OnError = lambda { |errStr| # (string)
      v.post(lambda {
        delete(v.hydrationJobs, hydration.Context().TransferKey)
        lcCfApiHydrationDevice.Warning("Hydration failed %s %s", hydration.Context(), errStr)

        opInfo = cf.CF_OPERATION_INFO.new()
        opInfo.StructSize = uint32(unsafe.Sizeof(opInfo))
        opInfo.Type = cf.CF_OPERATION_TYPE_TRANSFER_DATA

        opInfo.ConnectionKey = hydration.Context().ConnectionKey
        opInfo.TransferKey = hydration.Context().TransferKey

        opParams = cf.CF_OPERATION_PARAMETERS.new()
        opParams.ParamSize = sizeOfOpParamTransferData
        transfer = transferDataArm(@opParams)
        transfer.CompletionStatus = STATUS_CLOUD_FILE_NOT_IN_SYNC

        # the error affects the whole file, not a transfer chunk
        transfer.Offset = 0
        transfer.Length = totalSize

        if (err = cf.CfExecute(@opInfo, @opParams))
          lcCfApiHydrationDevice.Critical("Couldn't report error %s : %v",
            hydration.Context(), err)
        end
      })
    }

    return hydration
  end
end
