#go:build windows

require "context"

require "example.com/project/src/directory"
require "github.com/rs/zerolog/log"

module Windows
  # The entry points the openvfs package dispatches to. The cloud filter has no
  # mount and no socket API of its own: Windows is the provider, and the plugin
  # in this package is driven by the desktop client instead.

  # Run reports that the fuse filesystem has no Windows counterpart.
  def Run(ctx, root, owner, socketPath, onChange) # context.Context, string, string, string, func(directory.Event)
    log.Info().Msg("openvfs: the fuse filesystem is not available on Windows; the cloud filter is the provider")
  end

  # ServeAPI reports that the socket API has no Windows counterpart.
  def ServeAPI(ctx, socketPath, onChange) # (context.Context, string, func(directory.Event)) -> error
    log.Info().Msg("openvfs: the socket API is not available on Windows; the cloud filter has no such protocol")
    return nil
  end

  # Main reports that the openvfsfuse daemon has no Windows counterpart.
  def Main(ctx, argv) # (context.Context, []string) -> int
    log.Info().Msg("openvfs: the fuse daemon is not available on Windows")

    return -1
  end

  # RunStat reports that vfsstat has no Windows counterpart, because placeholder
  # state there belongs to the cloud filter rather than to extended attributes.
  def RunStat(argv) # ([]string) -> int
    log.Info().Msg("openvfs_stat: placeholder state on Windows is owned by the cloud filter")

    return -1
  end
end
